# Этот файл описывает только локальную разработку и не является готовым шаблоном Vercel environment.
# Не переносите APP_RUNTIME_MODE=mock и BITRIX24_MODE=mock в Vercel Preview или Production.
# Секретные переменные нельзя публиковать через NEXT_PUBLIC_, frontend bundle, Git или Vercel build output.
APP_RUNTIME_MODE=mock
BITRIX24_MODE=mock

# Идентичность единственного портала и ключ шифрования credentials доступны только серверу.
# Оставьте обе переменные идентичности портала пустыми до настройки portal foundation.
BITRIX24_PORTAL_MEMBER_ID=
BITRIX24_PORTAL_ORIGIN=
BITRIX24_CREDENTIALS_ENCRYPTION_KEY=
BITRIX24_TIMEZONE=Europe/Moscow

# Настройки и credentials production/live OAuth доступны только серверу.
# Production callback URI вычисляется из TASK_LAUNCHER_APP_ORIGIN добавлением
# /api/bitrix24/oauth/callback, а не из request host или отдельной production redirect-переменной.
TASK_LAUNCHER_APP_ORIGIN=
BITRIX24_OAUTH_CLIENT_ID=
BITRIX24_OAUTH_CLIENT_SECRET=

# Привилегированный Supabase Data API gateway доступен только серверу; service-role key является секретом.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Временный OAuth/portal identity spike предназначен только для локальных development/test.
# Эту spike-конфигурацию нельзя переносить в Vercel Preview или Production.
# Храните client credentials только в игнорируемом локальном environment-файле.
BITRIX24_OAUTH_SPIKE_ENABLED=false
BITRIX24_OAUTH_SPIKE_APP_ORIGIN=
BITRIX24_OAUTH_SPIKE_PORTAL_ORIGIN=
BITRIX24_OAUTH_SPIKE_EXPECTED_MEMBER_ID=
BITRIX24_OAUTH_SPIKE_CLIENT_ID=
BITRIX24_OAUTH_SPIKE_CLIENT_SECRET=
BITRIX24_OAUTH_SPIKE_REDIRECT_URI=
# Только server-side ожидания. Фактические права выбираются в интерфейсе локального приложения Bitrix24.
BITRIX24_OAUTH_SPIKE_TOKEN_SCOPE_HYPOTHESIS=app
BITRIX24_OAUTH_SPIKE_PERMISSION_HYPOTHESIS=user_brief
BITRIX24_OAUTH_SPIKE_TOKEN_ENDPOINT=https://oauth.bitrix.info/oauth/token/
